{
  "name": "moth-dlm",
  "version": "1.0.0",
  "description": "Moth Download Manager - a resumable, crash-recoverable, multi-threaded desktop download manager",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "author": "Moth",
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "benchmark:resume": "node scripts/benchmark-resume.mjs",
    "test:extension": "node --test \"browser-extension/test/*.test.mjs\"",
    "moth": "node scripts/moth.mjs",
    "moth:mcp": "node scripts/moth-mcp.mjs",
    "prepare:transmission": "node scripts/prepare-transmission.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "test:ingest": "npm run build && node scripts/testIngest.mjs",
    "icons": "node scripts/makeIcons.mjs && node scripts/makeExtensionIcons.mjs",
    "pack:extension": "node scripts/packExtension.mjs",
    "shortcut": "powershell -ExecutionPolicy Bypass -File scripts/shortcut.ps1",
    "postbuild": "node scripts/postbuild.mjs",
    "shot": "npm run build && node scripts/shot.mjs tmp/ui.png --seed",
    "verify": "npm run typecheck && npm run test && npm run test:extension && npm run smoke && node scripts/testIngest.mjs",
    "lint": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "postinstall": "node scripts/postinstall.mjs",
    "package": "npm run prepare:transmission && npm run build && electron-builder --dir",
    "dist": "npm run prepare:transmission && npm run build && electron-builder --publish never"
  },
  "dependencies": {
    "lucide-react": "1.48.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.2"
  },
  "build": {
    "appId": "dev.moth.downloader",
    "productName": "Moth Download Manager",
    "directories": {
      "output": "release/autopair-build",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "assets",
        "filter": [
          "**/*.png"
        ]
      },
      {
        "from": "resources/transmission/win-x64",
        "to": "assets/transmission/win-x64",
        "filter": [
          "*.exe",
          "*.dll"
        ]
      },
      {
        "from": "resources/transmission/source",
        "to": "assets/transmission/source",
        "filter": [
          "transmission-4.1.3.tar.xz"
        ]
      },
      {
        "from": "resources/transmission/NOTICE.md",
        "to": "assets/transmission/NOTICE.md"
      },
      {
        "from": "browser-extension",
        "to": "assets/browser-extension",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "scripts/moth.mjs",
        "to": "assets/cli/moth.mjs"
      },
      {
        "from": "scripts/moth-mcp.mjs",
        "to": "assets/cli/moth-mcp.mjs"
      },
      {
        "from": "scripts/diagnose.ps1",
        "to": "assets/diagnostics/diagnose.ps1"
      },
      {
        "from": "scripts/repair.ps1",
        "to": "assets/diagnostics/repair.ps1"
      }
    ],
    "asarUnpack": [],
    "win": {
      "icon": "resources/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Moth Download Manager"
    },
    "mac": {
      "icon": "resources/icon.png",
      "target": "dmg",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "icon": "resources/icon.png",
      "target": ["AppImage"],
      "category": "Network"
    }
  }
}
